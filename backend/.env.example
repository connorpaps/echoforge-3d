# Backend Microservice Variables (Server-Only Secrets)
CUDA_VISIBLE_DEVICES="0"
PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
HF_TOKEN="hf_your_free_read_token_here"
MAX_CONCURRENT_GPU_TASKS="1"
# Per-client limit for expensive mesh/texture/audio/NPC requests.
ECHOFORGE_GENERATION_RATE_LIMIT="10/minute"

# Mesh quality provider. `auto` uses the local Hunyuan3D-2GP sidecar when
# healthy, otherwise it falls back to TripoSR. `triposr` forces the baseline.
ECHOFORGE_MESH_BACKEND="auto"
HUNYUAN_SIDECAR_URL="http://127.0.0.1:8081"
HUNYUAN_TIMEOUT_S="900"
