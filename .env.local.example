# Next.js Public Flags (docs/07_SECURITY_AND_ENV.md §3.1)
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/ws"

# Renderer selection: "true" enables the experimental WebGPU renderer path
# (three/webgpu WebGPURenderer via R3F async gl factory). Default "false" =
# stable WebGL2 renderer with TSL materials.
NEXT_PUBLIC_ENABLE_WEBGPU="false"

# E2E hermetic mode: "true" substitutes deterministic fixture workers so CI
# tests never download models or touch the network. Never set in production.
NEXT_PUBLIC_E2E="false"
